"""Tests for upgrade step {{ source_version }} -> {{ destination_version }}."""
import pytest
from plone.app.testing import setRoles
from plone.app.testing import TEST_USER_ID

PROFILE_ID = "{{ package_name }}:default"
SOURCE = "{{ source_version }}"
DESTINATION = "{{ destination_version }}"


class TestUpgrade{{ destination_version | replace('.', '_') }}:
    """Upgrade {{ source_version }} -> {{ destination_version }}: {{ upgrade_step_title }}."""

    @pytest.fixture(autouse=True)
    def _setup(self, integration):
        self.portal = integration["portal"]
        setRoles(self.portal, TEST_USER_ID, ["Manager"])
        self.setup_tool = self.portal.portal_setup

    def test_upgrade_reaches_destination(self):
        self.setup_tool.setLastVersionForProfile(PROFILE_ID, SOURCE)

        self.setup_tool.upgradeProfile(PROFILE_ID, dest=DESTINATION)

        assert self.setup_tool.getLastVersionForProfile(PROFILE_ID) == (DESTINATION,)
