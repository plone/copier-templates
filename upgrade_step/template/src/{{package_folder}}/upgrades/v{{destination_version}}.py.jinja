"""{{ upgrade_step_title }}."""
import logging

logger = logging.getLogger(__name__)
{%- if upgrade_step_import_steps %}

UPGRADE_PROFILE = "profile-{{ package_name }}.upgrades:{{ destination_version }}"
{%- endif %}


def upgrade(context):
    """{{ upgrade_step_description }}

    Upgrade from profile version {{ source_version }} to {{ destination_version }}.
    """
    logger.info("Running upgrade step: {{ upgrade_step_title }}")
{%- for step in upgrade_step_import_steps %}
    context.runImportStepFromProfile(UPGRADE_PROFILE, "{{ step }}", run_dependencies=False)
{%- endfor %}
{%- if not upgrade_step_import_steps %}
    # TODO: implement the upgrade, e.g. remove stale persistent state.
{%- endif %}
